	measure _%_Devolvido =
			
			
			VAR retiradosTotal = SUM(f_MateriaisRetirados[Qtde. Remov.])
			VAR pendenteDEV = retiradosTotal - [_Qtd_Retirado_Devolvido]
			VAR pendenteDEVPER = DIVIDE(pendenteDEV, retiradosTotal, 0)
			RETURN
			
			DIVIDE(f_MateriaisRetirados[_Qtd_Retirado_Devolvido], retiradosTotal, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 422721c4-4447-4533-851f-0bdb1fd61c2c

		changedProperty = IsHidden

	measure _%_Convertido =
			
			VAR pendenteCONV = [_Qtd_Retirado_Devolvido] - [_Qtd_Retirado_Convertido]
			VAR pendenteCONVPER = DIVIDE(pendenteCONV, [_Qtd_Retirado_Devolvido], 0)
			RETURN
			
			DIVIDE([_Qtd_Retirado_Convertido], [_Qtd_Retirado_Devolvido], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 99d1ed6a-a017-43bc-ad59-c424c1d5fe73

