		annotation SummarizationSetBy = Automatic

	column 'Último Movimento Data' = ```
			
			
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			
			RETURN
			// 1. Saída Rápida: Se não tiver N° de Série, retorna a própria data de retirada imediatamente
			IF (
			    ISBLANK(vNumeroSerie) || vNumeroSerie = "-",
			    vDateTimeRetirada,
			    
			    // 2. Max Conferência (Tabela Virtual Minimizada com ALL)
			    VAR vMaxConferencia = 
			        MAXX (
			            FILTER (
			                ALL ( 
			                    'f_ConferenciaMovimento'[Cod.Compl.], 
			                    'f_ConferenciaMovimento'[DataHora Baixa]
			                ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                ('f_ConferenciaMovimento'[DataHora Baixa]) >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			        
			    // 3. Max Aplicação (Tabela Virtual Minimizada com ALL)
			    VAR vMaxAplicacao = 
			        MAXX (
			            FILTER (
			                ALL (
			                    'f_MateriaisAplicados'[N° Serie],
			                    'f_MateriaisAplicados'[DataHora Aplicacao]
			                ),
			                'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                ('f_MateriaisAplicados'[DataHora Aplicacao]) >= vDateTimeRetirada
			            ),
			            'f_MateriaisAplicados'[DataHora Aplicacao]
			        )
			
			    // 4. Max Nova Retirada (Tabela Virtual Minimizada com ALL)
			    VAR vMaxNovaRetirada = 
			        MAXX (
			            FILTER (
			                ALL (
			                    'f_MateriaisRetirados'[N° Serie],
			                    'f_MateriaisRetirados'[DataHora Retirada]
			                ),
			                'f_MateriaisRetirados'[N° Serie] = vNumeroSerie &&
			                ('f_MateriaisRetirados'[DataHora Retirada]) > vDateTimeRetirada
			            ),
			            'f_MateriaisRetirados'[DataHora Retirada]
			        )
			
			    // 5. Encontra a Data "Vencedora" Global
			    VAR vGlobalMax = MAX ( vMaxConferencia, MAX ( vMaxAplicacao, vMaxNovaRetirada ) )
			
			    // 6. Retorna a data vencedora ou a data inicial se não houve movimento futuro
			    RETURN
			        IF (
			            ISBLANK(vGlobalMax), 
			            vDateTimeRetirada, 
			            vGlobalMax 
			        )
			)
			```
		formatString: General Date
