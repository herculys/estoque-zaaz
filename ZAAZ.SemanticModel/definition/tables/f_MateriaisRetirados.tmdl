	column 'Último Movimento' = ```
			
			
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			
			RETURN
			// 1. Saída Rápida: Poupa processamento nas linhas não serializadas
			IF (
			    ISBLANK(vNumeroSerie) || vNumeroSerie = "-",
			    BLANK(),
			    
			    // 2. Max Conferência (Tabela Virtual Minimizada)
			    VAR vMaxConferencia = 
			        MAXX (
			            FILTER (
			                ALL ( 
			                    'f_ConferenciaMovimento'[Cod.Compl.], 
			                    'f_ConferenciaMovimento'[DataHora Baixa]
			                ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                ('f_ConferenciaMovimento'[DataHora Baixa]) >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			        
			    // 3. Max Aplicação
			    VAR vMaxAplicacao = 
			        MAXX (
			            FILTER (
			                ALL (
			                    'f_MateriaisAplicados'[N° Serie],
			                    'f_MateriaisAplicados'[DataHora Aplicacao]
			                ),
			                'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                ('f_MateriaisAplicados'[DataHora Aplicacao]) >= vDateTimeRetirada
			            ),
			            'f_MateriaisAplicados'[DataHora Aplicacao]
			        )
			
			    // 4. Max Nova Retirada
			    VAR vMaxNovaRetirada = 
			        MAXX (
			            FILTER (
			                ALL (
			                    'f_MateriaisRetirados'[N° Serie],
			                    'f_MateriaisRetirados'[DataHora Retirada]
			                ),
			                'f_MateriaisRetirados'[N° Serie] = vNumeroSerie &&
			                ('f_MateriaisRetirados'[DataHora Retirada]) > vDateTimeRetirada
			            ),
			            'f_MateriaisRetirados'[DataHora Retirada]
			        )
			
			    // 5. Maior Data Global
			    VAR vGlobalMax = MAX ( vMaxConferencia, MAX ( vMaxAplicacao, vMaxNovaRetirada ) )
			
			    // 6. Retorno otimizado (Sem Transição de Contexto)
			    RETURN
			        IF (
			            ISBLANK(vGlobalMax), 
			            BLANK(),
			            
			            SWITCH (
			                TRUE(),
			                vGlobalMax = vMaxNovaRetirada, "Nova Retirada",
			                vGlobalMax = vMaxAplicacao, "Reaplicado",
			                vGlobalMax = vMaxConferencia, 
			                    
			                    // Busca o Tipo de Movimento sem usar CALCULATE
			                    VAR vTipoMovimento = 
			                        MINX (
			                            FILTER (
			                                ALL (
			                                    'f_ConferenciaMovimento'[Cod.Compl.],
			                                    'f_ConferenciaMovimento'[DataHora Baixa],
			                                    'f_ConferenciaMovimento'[Tipo Movimento]
			                                ),
			                                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                                ('f_ConferenciaMovimento'[DataHora Baixa]) = vGlobalMax
			                            ),
			                            'f_ConferenciaMovimento'[Tipo Movimento]
			                        )
			                    
			                    RETURN
			                        // Switch direto em vTipoMovimento
			                        SWITCH (
			                            vTipoMovimento,
			                            "DM", "Devolução de Material",
			                            "CM", "Conversão de Material",
			                            "IE", "Inventário de Equipe",
			                            "IF", "Inventário Físico",
			                            "NF", "Nota Fiscal",
			                            "RM", "Requisição de Material",
			                            "TM", "Transferência de Material",
			                            "TF", "Transferência para Fornecedor",
			                            "", "Transferência entre Equipes",
			                            "NÃO MAPEADO (" & vTipoMovimento & ")"
			                        )
			            )
			        )
			)
			```
		lineageTag: bca15c62-fc6c-4f39-b247-0538cce80acb
		summarizeBy: none

