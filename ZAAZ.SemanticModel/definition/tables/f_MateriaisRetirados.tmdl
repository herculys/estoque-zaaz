				    #"Colunas Renomeadas" = Table.RenameColumns(#"Texto Extraído Antes do Delimitador",{{"Data", "Data Inclusão Material"}, {"OS", "OS de Retirada"}}),
				    #"Colunas Reordenadas1" = Table.ReorderColumns(#"Colunas Renomeadas",{"OS de Retirada", "Desc. Tipo Serv.", "Contrato", "Projeto", "Município", "Cód. Equipe", "Equipe", "Nº Cliente", "Data Aplicação", "Qtde. Aplic.", "Qtde. Remov.", "Cód. Material", "Material", "N° Serie", "Data Retirada", "Hora", "Usuário"}),
				    #"Linhas Filtradas" = Table.SelectRows(#"Colunas Renomeadas", each [#"Qtde. Remov."] > 0),
				    
				    // Criando a coluna de Condição Aplicada (Lógica 1)
				    Condição = Table.AddColumn(#"Linhas Filtradas", "Condição", each 
				    let 
				        Cod = Text.Upper(Text.From([Material])) 
				    in
				        if Text.Contains(Cod, "DEF-") or Text.Contains(Cod, "DET-") then "DEFEITO"
				        else if Text.Contains(Cod, "RET-") then "RETIRADO"
				        else if Text.Contains(Cod, "REAP-") or Text.Contains(Cod, "REA-") then "REAPROVEITADO"
				        else if Text.Contains(Cod, "SUC-") then "DESUSO"
				        else if [Material] <> null and [Material] <> "" then "NOVO"
				        else "VAZIO"
				    ),
				
				    // Criando a coluna de Verificação de N° de Série (Lógica 2)
				    NumSerie = Table.AddColumn(#"Condição", "Serializado?", each 
				        if [#"N° Serie"] = null or [#"N° Serie"] = "-" or [#"N° Serie"] = "" then "NÃO" 
				        else "SIM"
				    ),
				    #"Consultas Mescladas" = Table.NestedJoin(NumSerie, {"Desc. Tipo Serv."}, #"d_DE-PARA-SERVIÇO", {"DESC. TIPO SERV."}, "d_DE-PARA-SERVIÇO", JoinKind.LeftOuter),
				    #"d_DE-PARA-SERVIÇO Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "d_DE-PARA-SERVIÇO", {"CATEGORIA"}, {"d_DE-PARA-SERVIÇO.CATEGORIA"}),
