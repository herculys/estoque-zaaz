table f_MateriaisRetirados
	lineageTag: 8c41448f-5815-46ae-8177-0af3855edc36

	measure _Qtd_Retirado_Média = ```
			
			
			    VAR TabelaFiltrada = 
			        CALCULATETABLE(
			            DISTINCT(
			                SELECTCOLUMNS(
			                    'f_MateriaisRetirados',
			                    "MesRef", DATE(YEAR('f_MateriaisRetirados'[Data Aplicação]), 
			                                   MONTH('f_MateriaisRetirados'[Data Aplicação]), 1)
			                )
			            )
			        )  
			    VAR _MesesFiltrados = COUNTROWS(TabelaFiltrada)
			    VAR qtdAplic = SUM(f_MateriaisRetirados[Qtde. Remov.])
			
			    RETURN
			    IF(
			        _MesesFiltrados = 0,
			        BLANK(),
			        DIVIDE(qtdAplic, _MesesFiltrados, 0)
			    )
			```
		lineageTag: 0cefcff5-8d9b-4098-a8ce-e59e0c92fd72

		changedProperty = IsHidden

	measure _Qtd_Remov_Mes_Anterior = ```
			
			VAR MesAnterior = CALCULATE(
			    SUM(f_MateriaisRetirados[Qtde. Remov.]), 
			    DATEADD('d_Calendário'[Data], -1, MONTH)
			)
			RETURN
			MesAnterior
