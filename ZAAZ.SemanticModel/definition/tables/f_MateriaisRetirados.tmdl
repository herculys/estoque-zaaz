		variation Variation
			isDefault
			relationship: 066079f7-ec9c-4b9a-98d7-8cdfc276b134
			defaultHierarchy: LocalDateTable_e531521c-29e0-4cbd-acc4-67d752e98bf4.'Hierarquia de datas'

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Última Condição' = ```
			
			    
			// --- 1. Dados Iniciais ---
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			
			// Variável de controle para desativar buscas pesadas se não for serializado
			VAR vIsSerializado = NOT ( ISBLANK(vNumeroSerie) || vNumeroSerie = "-" )
			
			// --- 2 a 5. Buscas das Datas (Executadas apenas se for Serializado) ---
			VAR vMaxConferenciaOutros = 
			    IF ( vIsSerializado,
			        MAXX (
			            FILTER (
			                ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Tipo Movimento] ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                'f_ConferenciaMovimento'[Tipo Movimento] <> "CM" &&
			                ('f_ConferenciaMovimento'[DataHora Baixa]) >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			    )
			
			VAR vMaxConversao = 
			    IF ( vIsSerializado,
			        MAXX (
			            FILTER (
			                ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Tipo Movimento], 'f_ConferenciaMovimento'[Entrada] ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                'f_ConferenciaMovimento'[Tipo Movimento] = "CM" &&
			                'f_ConferenciaMovimento'[Entrada] = 1 &&
			                ('f_ConferenciaMovimento'[DataHora Baixa]) >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			    )
			
			VAR vMaxAplicacao = 
			    IF ( vIsSerializado,
			        MAXX (
			            FILTER (
			                ALL ( 'f_MateriaisAplicados'[N° Serie], 'f_MateriaisAplicados'[DataHora Aplicacao] ),
			                'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                ('f_MateriaisAplicados'[DataHora Aplicacao]) >= vDateTimeRetirada
			            ),
			            'f_MateriaisAplicados'[DataHora Aplicacao]
			        )
			    )
			
			VAR vMaxNovaRetirada = 
			    IF ( vIsSerializado,
			        MAXX (
			            FILTER (
			                ALL ( 'f_MateriaisRetirados'[N° Serie], 'f_MateriaisRetirados'[DataHora Retirada] ),
			                'f_MateriaisRetirados'[N° Serie] = vNumeroSerie &&
			                ('f_MateriaisRetirados'[DataHora Retirada]) > vDateTimeRetirada 
			            ),
			            'f_MateriaisRetirados'[DataHora Retirada]
			        )
			    )
			
			// --- 6. Data "Vencedora" Global ---
			VAR vGlobalMax = MAX ( vMaxConferenciaOutros, MAX ( vMaxConversao, MAX ( vMaxAplicacao, vMaxNovaRetirada ) ) )
			
			// --- 7. Verifica Condição Especial "PERDIDO" (Sem usar CALCULATE) ---
			VAR vStatusPerdido = 
			    IF (
			        vGlobalMax = vMaxConferenciaOutros && NOT ISBLANK(vGlobalMax),
			        // Busca ultra-rápida: se achar a linha exata que cumpre IF e Saída=1, retorna "PERDIDO"
			        VAR vAchouPerdido = 
			            MINX (
			                FILTER (
			                    ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Tipo Movimento], 'f_ConferenciaMovimento'[Saída] ),
			                    'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                    ('f_ConferenciaMovimento'[DataHora Baixa]) = vGlobalMax &&
			                    'f_ConferenciaMovimento'[Tipo Movimento] = "IF" &&
			                    'f_ConferenciaMovimento'[Saída] = 1
			                ),
			                "PERDIDO"
			            )
			        RETURN vAchouPerdido
			    )
			
			// --- 8. Encontra o Cód. Material "Vencedor" (Sem usar CALCULATE) ---
			VAR vWinningCodMat = 
			    SWITCH (
			        TRUE(),
			        ISBLANK(vGlobalMax), 
			            'f_MateriaisRetirados'[Material], 
			            
			        vGlobalMax = vMaxConferenciaOutros || vGlobalMax = vMaxConversao,
			            MINX (
			                FILTER (
			                    ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Descrição Material] ),
			                    'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                    ('f_ConferenciaMovimento'[DataHora Baixa]) = vGlobalMax
			                ),
			                'f_ConferenciaMovimento'[Descrição Material]
			            ),
			
			        vGlobalMax = vMaxAplicacao,
			            MINX (
			                FILTER (
			                    ALL ( 'f_MateriaisAplicados'[N° Serie], 'f_MateriaisAplicados'[DataHora Aplicacao], 'f_MateriaisAplicados'[Material] ),
			                    'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                    ('f_MateriaisAplicados'[DataHora Aplicacao]) = vGlobalMax
			                ),
			                'f_MateriaisAplicados'[Material]
			            ),
			
			        vGlobalMax = vMaxNovaRetirada, 
			            MINX (
			                FILTER (
			                    ALL ( 'f_MateriaisRetirados'[N° Serie], 'f_MateriaisRetirados'[DataHora Retirada], 'f_MateriaisRetirados'[Material] ),
			                    'f_MateriaisRetirados'[N° Serie] = vNumeroSerie &&
			                    ('f_MateriaisRetirados'[DataHora Retirada]) = vGlobalMax
			                ),
			                'f_MateriaisRetirados'[Material]
			            )
			    )
			
			// --- 9. Calcula a Condição Base ---
			VAR vBaseCondicao = 
			    IF(
			        vStatusPerdido = "PERDIDO", 
			        "PERDIDO",
			        
			        IF (
			            ISBLANK(vWinningCodMat),
			            BLANK(),
			            VAR vCodLower = LOWER(vWinningCodMat)
			            RETURN
			                // Substituição dos IFs aninhados por um SWITCH(TRUE) limpo
			                SWITCH (
			                    TRUE(),
			                    CONTAINSSTRING(vCodLower, "DEF-") || CONTAINSSTRING(vCodLower, "DET-"), "DEFEITO",
			                    CONTAINSSTRING(vCodLower, "RET-"), "RETIRADO",
			                    CONTAINSSTRING(vCodLower, "REAP-") || CONTAINSSTRING(vCodLower, "REA-"), "REAPROVEITADO",
			                    CONTAINSSTRING(vCodLower, "SUC-"), "DESUSO",
			                    IF(
			                        vCodLower <> BLANK() && vCodLower <> "-",
			                        "NOVO",
			                        BLANK()
			                    )
			                )
			        )
			    )
			
			// --- 10. Retorno Final ---
			RETURN
			    IF(
			        ISBLANK(vBaseCondicao) && 'f_MateriaisRetirados'[Status Movimento] = "Pendente Devolução",
			        'f_MateriaisRetirados'[Status Movimento], 
			        vBaseCondicao
			    )
			```
		lineageTag: 3eb49296-3d92-465c-943e-d320a6b5fac5
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Última Posição' = ```
			
			    
			// --- 1. Dados da linha atual (Retirada Original) ---
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			VAR vEquipeRetirada = 'f_MateriaisRetirados'[Equipe]
			
			// Variável de controle: impede varreduras se o item não for válido
			VAR vIsSerializado = NOT ( ISBLANK(vNumeroSerie) || vNumeroSerie = "-" )
			
			// --- 2. Momentos MÁXIMOS (Avaliado apenas se for serializado) ---
			VAR vMaxConferencia = 
			    IF ( vIsSerializado,
			        MAXX (
			            FILTER (
			                ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa] ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                'f_ConferenciaMovimento'[DataHora Baixa] >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			    )
			    
			VAR vMaxAplicacao = 
			    IF ( vIsSerializado,
			        MAXX (
			            FILTER (
			                ALL ( 'f_MateriaisAplicados'[N° Serie], 'f_MateriaisAplicados'[DataHora Aplicacao] ),
			                'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                'f_MateriaisAplicados'[DataHora Aplicacao] >= vDateTimeRetirada
			            ),
			            'f_MateriaisAplicados'[DataHora Aplicacao]
			        )
			    )
			
			VAR vMaxNovaRetirada = 
			    IF ( vIsSerializado,
			        MAXX (
			            FILTER (
			                ALL ( 'f_MateriaisRetirados'[N° Serie], 'f_MateriaisRetirados'[DataHora Retirada] ),
			                'f_MateriaisRetirados'[N° Serie] = vNumeroSerie &&
			                'f_MateriaisRetirados'[DataHora Retirada] > vDateTimeRetirada
			            ),
			            'f_MateriaisRetirados'[DataHora Retirada]
			        )
			    )
			
			// --- 3. Encontra a Data "Vencedora" Global ---
			VAR vGlobalMax = MAX ( vMaxConferencia, MAX ( vMaxAplicacao, vMaxNovaRetirada ) )
			
			// --- 4. Retorna a POSIÇÃO ---
			RETURN
			    IF ( NOT vIsSerializado, 
			        BLANK(), // Retorno rápido para ignorar os não-serializados
			        
			        SWITCH (
			            TRUE(),
			            
			            // Caso 0: Nenhum movimento FUTURO.
			            ISBLANK(vGlobalMax), "MESMO VOLANTE",
			            
			            // Caso 1: A Aplicação é a mais recente
			            vGlobalMax = vMaxAplicacao, "ASSINANTE",
			            
			            // Caso 2: Nova Retirada
			            vGlobalMax = vMaxNovaRetirada,
			                VAR vEquipeNovaRetirada = 
			                    MAXX (
			                        FILTER (
			                            ALL ( 'f_MateriaisRetirados'[N° Serie], 'f_MateriaisRetirados'[DataHora Retirada], 'f_MateriaisRetirados'[Equipe] ),
			                            'f_MateriaisRetirados'[N° Serie] = vNumeroSerie &&
			                            'f_MateriaisRetirados'[DataHora Retirada] = vGlobalMax
			                        ),
			                        'f_MateriaisRetirados'[Equipe]
			                    )
			                RETURN 
			                    IF (vEquipeNovaRetirada = vEquipeRetirada, "MESMO VOLANTE", "OUTRO VOLANTE" ),
			
			            // Caso 3: A Conferencia é a mais recente
			            vGlobalMax = vMaxConferencia,
			                
			                // Variáveis extraídas da memória de forma isolada e sem Transição de Contexto
			                VAR vTipoMovimento = MINX ( FILTER ( ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Tipo Movimento] ), 'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie && 'f_ConferenciaMovimento'[DataHora Baixa] = vGlobalMax ), 'f_ConferenciaMovimento'[Tipo Movimento] )
			                VAR vSaida = MINX ( FILTER ( ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Saída] ), 'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie && 'f_ConferenciaMovimento'[DataHora Baixa] = vGlobalMax ), 'f_ConferenciaMovimento'[Saída] )
			                VAR vEntrada = MINX ( FILTER ( ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Entrada] ), 'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie && 'f_ConferenciaMovimento'[DataHora Baixa] = vGlobalMax ), 'f_ConferenciaMovimento'[Entrada] )
			                VAR vNroDoc = MINX ( FILTER ( ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Nº. Doc] ), 'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie && 'f_ConferenciaMovimento'[DataHora Baixa] = vGlobalMax ), 'f_ConferenciaMovimento'[Nº. Doc] )
			                VAR vNomeConferencia = MINX ( FILTER ( ALL ( 'f_ConferenciaMovimento'[Cod.Compl.], 'f_ConferenciaMovimento'[DataHora Baixa], 'f_ConferenciaMovimento'[Nome] ), 'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie && 'f_ConferenciaMovimento'[DataHora Baixa] = vGlobalMax ), 'f_ConferenciaMovimento'[Nome] )
			                
			                VAR vStatusVolante = IF ( vNomeConferencia = vEquipeRetirada, "MESMO VOLANTE", "OUTRO VOLANTE" )
			
			                RETURN
			                    SWITCH (
			                        TRUE(),
			                        // --- LÓGICA DO PERDIDO ADICIONADA AQUI COMO PRIORIDADE ---
			                        (vTipoMovimento = "IF" && vSaida = 1), "PERDIDO",
			                        
			                        (ISBLANK(vTipoMovimento) || vTipoMovimento = "") && NOT(ISBLANK(vNroDoc)) && CONTAINSSTRING(vNroDoc, "T"), vStatusVolante,
			                        (vTipoMovimento = "IF" && vEntrada > 0), "ESTOQUE",
			                        (vTipoMovimento = "IE" && vEntrada > 0), "VOLANTE", 
			                        (vTipoMovimento = "IE" && vSaida > 0 && (ISBLANK(vNomeConferencia) || vNomeConferencia = "")), "PERDIDO VOLANTE",
			                        (vTipoMovimento = "IE" && vSaida > 0 && NOT(ISBLANK(vNomeConferencia) || vNomeConferencia = "")), "MESMO VOLANTE",
			                        vTipoMovimento IN {"NF", "CM", "DM", "TM"}, "ESTOQUE",
			                        vTipoMovimento = "RM", vStatusVolante,
			                        BLANK()
			                    )
			        )
			    )
			```
