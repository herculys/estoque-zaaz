	column 'Posse (Dias)' = ```
			
			------------------------------------ Código simples ---------------------------------------------------------------------------------------
			
			//LOOKUPVALUE('f_SituaçãoMateriaisSaldoVolante'[Posse (Dias)], 'f_SituaçãoMateriaisSaldoVolante'[Nº Serial], f_SaldoVolante[COMPLEMENTAR], BLANK())
			
			 ----------------------------------- Código recente ---------------------------------------------------------------------------------------
			// 1. Armazenar os valores da linha atual em variáveis
			VAR vNome = [NOME]
			VAR vSerial = [COMPLEMENTAR]
			VAR vDescricao = [DESCRICAO]
			VAR vSaldo = [SALDO]
			RETURN
			// 2. Saída rápida: Se não houver serial, não perde tempo calculando
			IF (
			    ISBLANK(vSerial) || vSerial = "-" || vSaldo < 0,
			    BLANK(),
			    
			    // 3. Busca iterando apenas a tabela virtual minimizada (sem IFERROR)
			    MINX (
			        FILTER (
			            ALL (
			                'f_SituaçãoMateriaisSaldoVolante'[Nº Serial],
			                'f_SituaçãoMateriaisSaldoVolante'[Nome],
			                'f_SituaçãoMateriaisSaldoVolante'[Descrição Material],
			                'f_SituaçãoMateriaisSaldoVolante'[Posse (Dias)]
			            ),
			            // 4. Uso do operador '&&' com a condição mais restritiva (Nº Serial) primeiro
			            'f_SituaçãoMateriaisSaldoVolante'[Nº Serial] = vSerial &&
			            'f_SituaçãoMateriaisSaldoVolante'[Nome] = vNome &&
			            'f_SituaçãoMateriaisSaldoVolante'[Descrição Material] = vDescricao
			        ),
			        'f_SituaçãoMateriaisSaldoVolante'[Posse (Dias)]
			    )
			)
			
			------------------------------------ Código antigo --------------------------------------------------------------------------------------- */
			/* ----------------------
			-- Códigos antigos
			Data Hora da Retirada = VAR vDescricao = COALESCE ( 'f_SaldoVolante'[DESCRICAO], "" )
			VAR vComplementar = TRIM ( COALESCE ( 'f_SaldoVolante'[COMPLEMENTAR], "" ) )
			RETURN
			    IF (
			        CONTAINSSTRING ( vDescricao, "RET-" )
			            && vComplementar <> ""
			            && vComplementar <> "-",
			        CALCULATE (
			            MAX ( 'f_MateriaisRetirados'[DataHora Retirada] ),
			            FILTER (
			                'f_MateriaisRetirados',
			                COALESCE ( 'f_MateriaisRetirados'[N° Serie], "" )  = vComplementar
			            )
			        )
			    )
			*/ ----------------------
			
			/* ----------------------
			Dias desde Retirada = IF (
			    NOT ISBLANK ( 'f_SaldoVolante'[Data Hora da Retirada] ),
			    DATEDIFF ( 'f_SaldoVolante'[Data Hora da Retirada], TODAY (), DAY )
			)
			*/ ----------------------
			```
		dataType: int64
		formatString: 0
		lineageTag: 84f2b73c-0f35-48d4-a181-88e474734e71
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

