table f_SaldoVolante
	lineageTag: f7c12807-ba20-4618-a4be-9e44f7079ab6

	measure 'Qtde. Aplic. Novo' = ```
			
			/*
			CALCULATE(
			    SUM(f_MateriaisAplicados[Qtde. Aplic.]), 
			    f_MateriaisAplicados[Condição] = "NOVO"
			)
			*/
			VAR aplicados = (ISINSCOPE(d_ListagemEquipes[Supervisor]) || ISINSCOPE(d_ListagemEquipes[Nome]))  && NOT ISINSCOPE(f_SaldoVolante[d_DE-PARA-TECNOLOGIA.CATEGORIA])
			RETURN
			
			IF(aplicados,
			    CALCULATE(
			        SUM(f_MateriaisAplicados[Qtde. Aplic.]), 
			        f_MateriaisAplicados[Condição] = "NOVO"
			    ),
			    BLANK()
			)
			```
		formatString: 0
		lineageTag: a0e24b59-1fba-498b-9edb-cbc84a4df2f2

		annotation PBI_FormatHint = {"isDecimal":true}

