	partition f_SaldoVolante = m
		mode: import
		queryGroup: Estoque
		source = ```
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta Raiz" & "\Saldo Volante\Saldo Volante.csv"),[Delimiter=";", Columns=16, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Personalizar1 = Table.TransformColumns(#"Cabeçalhos Promovidos", {}, each if _ is text then Text.TrimStart(_, "'") else _),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Personalizar1,{{"COD_CCUSTO", type text}, {"DESC_CCUSTO", type text}, {"CONTRATO", type text}, {"PROJETO", type text}, {"EQUIPE", type text}, {"NOME", type text}, {"MATERIAL", type text}, {"DESCRICAO", type text}, {"COMPLEMENTAR", type text}, {"ENTRADA", Int64.Type}, {"SAIDA", Int64.Type}, {"APLICADO", Int64.Type}, {"REMOVIDO", Int64.Type}, {"SALDO", Int64.Type}, {"VALOR_UNID", type number}, {"VALOR_TOTAL", type number}}),
				    #"Erros Substituídos" = Table.ReplaceErrorValues(#"Tipo Alterado", {{"ENTRADA", null}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Erros Substituídos",{"COD_CCUSTO", "DESC_CCUSTO", "VALOR_UNID", "VALOR_TOTAL", "ENTRADA", "SAIDA", "APLICADO", "REMOVIDO"}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Colunas Removidas",{{"EQUIPE", Int64.Type}}),
				    #"Erros Substituídos1" = Table.ReplaceErrorValues(#"Tipo Alterado1", {{"EQUIPE", null}}),
				    // Criando a coluna de Condição Aplicada (Lógica 1)
				    Condição = Table.AddColumn(#"Erros Substituídos1", "Condição", each 
				    let 
				        Cod = Text.Upper(Text.From([DESCRICAO])) 
				    in
				        if Text.Contains(Cod, "DEF-") or Text.Contains(Cod, "DET-") then "DEFEITO"
				        else if Text.Contains(Cod, "RET-") then "RETIRADO"
				        else if Text.Contains(Cod, "REAP-") or Text.Contains(Cod, "REA-") then "REAPROVEITADO"
				        else if Text.Contains(Cod, "SUC-") then "DESUSO"
				        else if [DESCRICAO] <> null and [DESCRICAO] <> "" then "NOVO"
				        else "VAZIO"
				    ),
				
				    // Criando a coluna de Verificação de N° de Série (Lógica 2)
				    NumSerie = Table.AddColumn(#"Condição", "Serializado?", each 
				        if [COMPLEMENTAR] = null or [COMPLEMENTAR] = "-" or [COMPLEMENTAR] = "" then "NÃO" 
				        else "SIM"
				    ),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(NumSerie,{{"Condição", type text}, {"Serializado?", type text}}),
				    #"Consultas Mescladas1" = Table.NestedJoin(#"Tipo Alterado2", {"DESCRICAO"}, #"d_DE-PARA-TECNOLOGIA", {"EQUIPAMENTO"}, "d_DE-PARA-TECNOLOGIA", JoinKind.LeftOuter),
				    #"d_DE-PARA-TECNOLOGIA Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas1", "d_DE-PARA-TECNOLOGIA", {"CATEGORIA"}, {"d_DE-PARA-TECNOLOGIA.CATEGORIA"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"d_DE-PARA-TECNOLOGIA Expandido",null,"NÃO MAPEADO",Replacer.ReplaceValue,{"d_DE-PARA-TECNOLOGIA.CATEGORIA"})
				in
				    #"Valor Substituído1"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

