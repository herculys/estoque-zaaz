	column 'Plano Velocidade' =
			
			VAR OSAtual = f_MateriaisAplicados[OS]
			RETURN
			COALESCE(
			CALCULATE(
			    CONCATENATEX(
			        DISTINCT('f_Solicitacoes'[Velocidade Agrupada]),
			        'f_Solicitacoes'[Velocidade Agrupada],
			        " | "
			    ),
			    FILTER(
			        ALL('f_Solicitacoes'),
			        'f_Solicitacoes'[Nº. Ordem Serviço] = OSAtual
			    )
			), "NÃO IDENTIFICADO")
		dataType: string
		lineageTag: 0dfb0b54-e58e-4dba-a242-b1848763b0ae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Bruto Velocidade' =
			
			VAR OSAtual = f_MateriaisAplicados[OS]
			RETURN
			COALESCE(
			CALCULATE(
			    CONCATENATEX(
			        DISTINCT('f_Solicitacoes'[Observação]),
			        'f_Solicitacoes'[Observação],
			        " | "
			    ),
			    FILTER(
			        ALL('f_Solicitacoes'),
			        'f_Solicitacoes'[Nº. Ordem Serviço] = OSAtual
			    )
			), "NÃO IDENTIFICADO")
		lineageTag: b2e9e691-1267-400e-b09e-f1489a248bc4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Plano VelocidadeB' = ```
			
			
			--- CÓDIGO TEMPORARIO, TROCAR POR MINX OU REMOVER DUPLICATAS NUM OS ----
			/*
			VAR Velocidade = 
			    CALCULATE(
			        CONCATENATEX(
			            DISTINCT('f_Solicitacoes'[Velocidade do Plano]),
			            'f_Solicitacoes'[Velocidade do Plano],
			            ""
			        ),
			        FILTER(
			            ALL('f_Solicitacoes'),
			            'f_Solicitacoes'[Nº. Ordem Serviço] = f_MateriaisAplicados[OS]
			        )
			    )
			RETURN
			
			IF(
			    Velocidade <> "" && velocidade <> BLANK(),
			    Velocidade, 
			    BLANK()
			)
			*/
			
			VAR vOS = f_MateriaisAplicados[OS]
			
			VAR Velocidade = 
			    CALCULATE(
			        MAX('f_Solicitacoes'[Velocidade do Plano]),
			        FILTER(
			            ALL('f_Solicitacoes'[Nº. Ordem Serviço]),
			            'f_Solicitacoes'[Nº. Ordem Serviço] = vOS
			        )
			    )
			RETURN
			    Velocidade
			```
		dataType: int64
		formatString: 0
		lineageTag: 6179d121-0ce8-4433-bb1b-786efa645ef1
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column 'OTIMIZAÇÃO APLICAÇÃO' = ```
			
			VAR velocidade = f_MateriaisAplicados[Plano VelocidadeB]
			RETURN
			
			SWITCH(
			    TRUE(),
			    velocidade > 0 && velocidade < 300, "WIFI 5", 
			    velocidade >= 300 && Velocidade <= 10000, "WIFI 6",
			    "SEM INFORMAÇÃO PLANO"
			)
			```
		lineageTag: 92e04dd0-0f7b-4d52-a3ec-510288690e16
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

