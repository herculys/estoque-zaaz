	partition f_MateriaisAplicados = m
		mode: import
		queryGroup: 'Tabelas Principais'
		source = ```
				let 
				    Fonte = Folder.Files(#"Pasta Raiz" & "\Materiais Aplicados & Retirados"),
				    #"Arquivos Ocultos Filtrados1" = Table.SelectRows(Fonte, each [Attributes]?[Hidden]? <> true),
				    #"Invocar Função Personalizada1" = Table.AddColumn(#"Arquivos Ocultos Filtrados1", "Transformar Arquivo", each #"Transformar Arquivo"([Content])),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Invocar Função Personalizada1", {"Name", "Nome da Origem"}),
				    #"Outras Colunas Removidas1" = Table.SelectColumns(#"Colunas Renomeadas1",{"Transformar Arquivo"}),
				    #"Coluna de Tabela Expandida1" = Table.ExpandTableColumn(#"Outras Colunas Removidas1", "Transformar Arquivo", Table.ColumnNames(#"Transformar Arquivo"(#"Arquivo de Amostra"))),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Coluna de Tabela Expandida1",{{"Contrato", type text}, {"Projeto", type text}, {"Cód. Equipe", Int64.Type}, {"Equipe", type text}, {"Município", type text}, {"Nº Cliente", Int64.Type}, {"Nome do Cliente", type text}, {"OS", type text}, {"Data Aplicação", type date}, {"Desc. Tipo Serv.", type text}, {"Cód. Material", type text}, {"Material", type text}, {"N° Serie", type text}, {"Qtde. Aplic.", type number}, {"Qtde. Remov.", Int64.Type}, {"Hora", type time}, {"Data", type date}, {"Usuário", type text}}),
				    
				    // Filtro Ajustado
				    /*
				    #"Filtro de materiais" = Table.SelectRows(#"Tipo Alterado", each 
				        (
				            [Data Aplicação] <= #date(2025, 12, 31) and 
				            Record.Field(_, "N° Serie") <> null and 
				            Record.Field(_, "N° Serie") <> "-"
				        ) 
				        or 
				        (
				            [Data Aplicação] >= #date(2026, 1, 1)
				        )
				    ),
				    
				    #"Linhas Filtradas1" = Table.SelectRows(#"Filtro de materiais", each [#"Qtde. Aplic."] > 0),
				    */
				
				    #"Linhas Filtradas1" = Table.SelectRows(#"Tipo Alterado", each [#"Qtde. Aplic."] > 0),
				
				    #"Texto Extraído Antes do Delimitador" = Table.TransformColumns(#"Linhas Filtradas1", {{"OS", each Text.BeforeDelimiter(_, "/"), type text}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Texto Extraído Antes do Delimitador",{{"Data", "Data Inclusão Material"}}),
				
				
				    // Criando a coluna de Condição Aplicada (Lógica 1)
				    Condição = Table.AddColumn(#"Colunas Renomeadas", "Condição", each 
				    let 
				        Cod = Text.Upper(Text.From([Material])) 
				    in
				        if Text.Contains(Cod, "DEF-") or Text.Contains(Cod, "DET-") then "DEFEITO"
				        else if Text.Contains(Cod, "RET-") then "RETIRADO"
				        else if Text.Contains(Cod, "REAP-") or Text.Contains(Cod, "REA-") then "REAPROVEITADO"
				        else if Text.Contains(Cod, "SUC-") then "DESUSO"
				        else if [Material] <> null and [Material] <> "" then "NOVO"
				        else "VAZIO"
				    ),
				
				    // Criando a coluna de Verificação de N° de Série (Lógica 2)
				    NumSerie = Table.AddColumn(#"Condição", "Serializado?", each 
				        if [#"N° Serie"] = null or [#"N° Serie"] = "-" or [#"N° Serie"] = "" then "NÃO" 
				        else "SIM"
				    ),
				    #"Consultas Mescladas" = Table.NestedJoin(NumSerie, {"Desc. Tipo Serv."}, #"d_DE-PARA-SERVIÇO", {"DESC. TIPO SERV."}, "d_DE-PARA-SERVIÇO", JoinKind.LeftOuter),
				    #"d_DE-PARA-SERVIÇO Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "d_DE-PARA-SERVIÇO", {"CATEGORIA"}, {"d_DE-PARA-SERVIÇO.CATEGORIA"}),
				    #"Valor Substituído" = Table.ReplaceValue(#"d_DE-PARA-SERVIÇO Expandido",null,"NÃO MAPEADO",Replacer.ReplaceValue,{"d_DE-PARA-SERVIÇO.CATEGORIA"}),
				    #"Consultas Mescladas1" = Table.NestedJoin(#"Valor Substituído", {"Material"}, #"d_DE-PARA-TECNOLOGIA", {"EQUIPAMENTO"}, "d_DE-PARA-TECNOLOGIA", JoinKind.LeftOuter),
				    #"d_DE-PARA-TECNOLOGIA Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas1", "d_DE-PARA-TECNOLOGIA", {"CATEGORIA"}, {"d_DE-PARA-TECNOLOGIA.CATEGORIA"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"d_DE-PARA-TECNOLOGIA Expandido",null,"NÃO MAPEADO",Replacer.ReplaceValue,{"d_DE-PARA-TECNOLOGIA.CATEGORIA"}),
				    #"Colunas Reordenadas" = Table.ReorderColumns(#"Valor Substituído1",{"Contrato", "Projeto", "Cód. Equipe", "Equipe", "Município", "Nº Cliente", "Nome do Cliente", "OS", "Data Aplicação", "Desc. Tipo Serv.", "Cód. Material", "Material", "N° Serie", "Qtde. Aplic.", "Qtde. Remov.", "Natureza", "Hora", "Data Inclusão Material", "Usuário", "d_DE-PARA-SERVIÇO.CATEGORIA", "Condição", "Serializado?", "d_DE-PARA-TECNOLOGIA.CATEGORIA"}),
				    #"Erros Substituídos" = Table.ReplaceErrorValues(#"Colunas Reordenadas", {{"Condição", "VAZIO"}}),
				    #"Personalização Adicionada" = Table.AddColumn(#"Erros Substituídos", "DataHora Aplicacao", each DateTime.From(Text.From([Data Inclusão Material]) & " " & Text.From([Hora]))),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Personalização Adicionada",{{"DataHora Aplicacao", type datetime}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado1",{"Hora", "Data Inclusão Material"})
				in
				    #"Colunas Removidas"
				```

	annotation PBI_NavigationStepName = Navegação

