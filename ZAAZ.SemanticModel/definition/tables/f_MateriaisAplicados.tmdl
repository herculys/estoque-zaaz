table f_MateriaisAplicados
	lineageTag: c9edd4f3-3508-4a0b-85d4-04ac6d758f37

	measure _ConsumoMédioMês = ```
			
			    VAR TabelaFiltrada = 
			        CALCULATETABLE(
			            DISTINCT(
			                SELECTCOLUMNS(
			                    'f_MateriaisAplicados',
			                    "MesRef", DATE(YEAR('f_MateriaisAplicados'[Data Aplicação]), 
			                                   MONTH('f_MateriaisAplicados'[Data Aplicação]), 1)
			                )
			            )
			        )  
			    VAR _MesesFiltrados = COUNTROWS(TabelaFiltrada)
			    VAR qtdAplic = SUM(f_MateriaisAplicados[Qtde. Aplic.])
			
			    RETURN
			    IF(
			        _MesesFiltrados = 0,
			        BLANK(),
			        DIVIDE(qtdAplic, _MesesFiltrados, 0)
			    )
			```
		lineageTag: cbbd176e-1844-4892-93ea-1742d103d962

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_qtd. Aplic. Mes Anterior' = ```
			
			VAR MesAnterior = CALCULATE(
			    SUM(f_MateriaisAplicados[Qtde. Aplic.]), 
			    DATEADD('d_Calendário'[Data], -1, MONTH)
			)
			RETURN
			MesAnterior
			```
		lineageTag: 8150b30a-3332-4d74-b7c0-1c686aca257f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Diferença MoM %' =
			
			VAR MesAtual = SUM(f_MateriaisAplicados[Qtde. Aplic.])
			VAR MesAnterior = [_qtd. Aplic. Mes Anterior]
			VAR CalcDiffMes = DIVIDE( MesAtual - MesAnterior, MesAnterior, 0 )
			RETURN
			CalcDiffMes
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a16e2562-7cdb-476e-a499-ada38f8e21b4

	measure '_% do total serv.' = ```
			
			/*VAR MesAtual = SUM(f_MateriaisAplicados[Qtde. Aplic.])
			VAR TotalMes = CALCULATE(
			    SUM(f_MateriaisAplicados[Qtde. Aplic.]),
			    REMOVEFILTERS(f_MateriaisAplicados[d_DE-PARA-SERVIÇO.CATEGORIA]),
			    REMOVEFILTERS(f_MateriaisAplicados[d_DE-PARA-TECNOLOGIA.CATEGORIA])
			)
			RETURN
			DIVIDE( MesAtual, TotalMes, 0 )*/
			
			VAR totalmes = CALCULATE(
			    SUM(f_MateriaisAplicados[Qtde. Aplic.]), 
			    /*ALLEXCEPT(
			        f_MateriaisAplicados,
			        f_MateriaisAplicados[DataHora Aplicacao],
			        f_MateriaisAplicados[Serializado?],
			        f_MateriaisAplicados[Condição],
			        f_MateriaisAplicados[Material],
			        f_MateriaisAplicados[Cód. Material],
			        f_MateriaisAplicados[Projeto]
			    ),*/
			    KEEPFILTERS('d_Calendário'),
			    REMOVEFILTERS(f_MateriaisAplicados[d_DE-PARA-TECNOLOGIA.CATEGORIA]),
			    REMOVEFILTERS(f_MateriaisAplicados[d_DE-PARA-SERVIÇO.CATEGORIA])
			)
			RETURN
			
			DIVIDE(SUM(f_MateriaisAplicados[Qtde. Aplic.]), totalmes, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 64b65f6b-7066-4121-90e6-71e3c9046c1d

	measure 'SUM qtd aplic' = SUM(f_MateriaisAplicados[Qtde. Aplic.])
		lineageTag: 3a7b967d-5f22-4b65-981e-e5e7c393a26b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Entregue/Aplic' =
			
			
			
			DIVIDE([SUM qtd aplic]+[_Qtd_Devolvida_REAP+NOVO], [_Qtd_Requisitada], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8ed0381e-b6fe-4b35-96fc-e81cf488295a

