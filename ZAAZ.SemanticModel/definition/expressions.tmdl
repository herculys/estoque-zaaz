		    fixCOMBO1 = Table.ReplaceValue(#"Linhas Classificadas","COMBO","PACOTE",Replacer.ReplaceText,{"Observação"}),
		    fixCombo2 = Table.ReplaceValue(fixCOMBO1,"Combo","Pacote",Replacer.ReplaceText,{"Observação"}),
		    fixcombo3 = Table.ReplaceValue(fixCombo2,"combo","pacote",Replacer.ReplaceText,{"Observação"}),
		    
